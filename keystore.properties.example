# Copy to keystore.properties and fill in. That file and the .jks are gitignored —
# never commit either.
#
# Generate the upload key first (from the project root):
#
#   keytool -genkeypair -v -keystore sapiospend-upload.jks \
#           -alias sapiospend -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the project root.

storeFile=sapiospend-upload.jks
storePassword=
keyAlias=sapiospend
keyPassword=
