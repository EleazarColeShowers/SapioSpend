<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ only. Below it, being installed is consent, and the permission does
         not exist to request. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarms do not survive a reboot. Without this the daily reminder tick would be
         lost the first time the phone restarts and never come back. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SapioSpend">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SapioSpend"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The single alarm behind reminders and check-ins, plus the events that would
             otherwise silently drop it: a reboot, an app update, and the clock or time
             zone moving under an alarm set for an absolute instant.

             Not exported: only the system and this app have any business waking it. -->
        <receiver
            android:name=".notify.DailyTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.el.sapiospend.action.DAILY_TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Grants other apps temporary read access to exported reports so the share
             sheet can hand a PDF or spreadsheet to Gmail, WhatsApp or Drive. Not
             exported: only this app may hand out the permission grants. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>