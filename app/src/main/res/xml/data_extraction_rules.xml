<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+. Same reasoning as backup_rules.xml: the database is worth backing up, the
  receipt images are not — they would eat the cloud-backup quota and take the budgets
  with them.

  Device transfer has no such quota, so a phone-to-phone move keeps the photos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="receipts/" />
    </cloud-backup>
</data-extraction-rules>
