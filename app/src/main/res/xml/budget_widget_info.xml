<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 30 minutes, the shortest the platform actually honours — anything
  smaller is silently rounded up. It is a backstop rather than the main path: the widget
  is refreshed directly whenever the app writes, which is what makes it feel live.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_budget"
    android:previewLayout="@layout/widget_budget"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
