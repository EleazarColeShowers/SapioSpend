<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept to text and one button. A widget is redrawn by the launcher from a RemoteViews
  tree, which supports only a fixed set of views — no Compose, no custom drawing — so the
  design here is the app's overview card reduced to what that vocabulary can express.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:id="@+id/widget_root">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_label"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_button"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center"
        android:text="@string/widget_add_expense"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
